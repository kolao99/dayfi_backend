{
  "name": "account",
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && node dist/src/index.js",
    "start:prod": "node -r dotenv/config scripts/wait-for-postgres.cjs && node -r dotenv/config scripts/db-migrate-up.cjs && node dist/src/index.js",
    "build": "rm -rf dist && tsc",
    "migrate:up": "node -r dotenv/config scripts/wait-for-postgres.cjs && node -r dotenv/config scripts/db-migrate-up.cjs",
    "prestart": "npm run migrate:up",
    "dev": "nodemon --exec ts-node ./src/index.ts --mode development",
    "predb:up": "docker info > /dev/null 2>&1 || (echo 'Docker daemon is not reachable. Start Docker Desktop (or dockerd), then retry npm run db:up.' >&2 && exit 1)",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:listen": "lsof -nP -iTCP:${DAYFI_PORT:-3000} -sTCP:LISTEN || true",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "node scripts/npm-prepare-husky.cjs",
    "migrations": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate",
    "migrate:down": "node -r dotenv/config scripts/wait-for-postgres.cjs && node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate down --config database.json",
    "migrate-test:up": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate up --config database.json -e test",
    "migrate-test:down": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate down -c 100 --config database.json -e test",
    "migrate:reset": "node -r dotenv/config scripts/wait-for-postgres.cjs && node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate reset --config database.json",
    "migrate-test:reset": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate reset --config database.json -e test",
    "egress-ip": "ts-node -r dotenv/config scripts/print-egress-ip.ts",
    "fw:smoke": "ts-node -r dotenv/config scripts/flutterwave-smoke.ts",
    "fw:reconcile": "ts-node -r dotenv/config scripts/reconcile-flutterwave-deposits.ts",
    "yc:smoke": "ts-node -r dotenv/config scripts/yellowcard-smoke.ts",
    "smoke:providers": "npm run egress-ip && npm run fw:smoke && npm run yc:smoke",
    "grey:smoke": "ts-node -r dotenv/config scripts/grey-smoke.ts",
    "deposit:usd": "ts-node -r dotenv/config scripts/simulate-usd-bank-deposit.ts",
    "fix:grey-deposit": "ts-node -r dotenv/config scripts/fix-duplicate-grey-deposit.ts",
    "db:clear-users": "ts-node -r dotenv/config scripts/clear-test-users.ts",
    "stellar:diagnose": "ts-node -r dotenv/config scripts/stellar-sync-diagnose.ts",
    "seed:create": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate create update-transaction-table --config database.json",
    "seed:down": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate down:seed --config database.json",
    "seed:reset": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate reset:seed --config database.json",
    "seed:reset:test": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate reset:seed --config database.json -e test",
    "seed:up:test": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate up:seed --config database.json -e test"
  },
  "dependencies": {
    "@joi/date": "^2.1.1",
    "@stellar/stellar-sdk": "^13.3.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.0",
    "bluebird": "^3.7.2",
    "chai-http": "^4.4.0",
    "cors": "^2.8.5",
    "country-list": "^2.3.0",
    "cron": "^3.5.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "db-migrate": "^0.11.13",
    "db-migrate-pg": "^1.3.0",
    "device-detector-js": "^3.0.3",
    "dotenv": "^16.3.0",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "generate-password": "^1.7.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.2.0",
    "joi": "^17.9.2",
    "joi-password": "^4.2.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "mocha": "^10.8.2",
    "morgan": "^1.10.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.13.1",
    "pg-promise": "^11.5.4",
    "stellar-hd-wallet": "^0.0.9",
    "twilio": "^5.10.1",
    "typescript": "^5.7.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/bluebird": "^3.5.42",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/md5": "^2.3.5",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.3.1",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "chai": "^4.3.7",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^35.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "husky": "^9.1.5",
    "nodemon": "^2.0.22",
    "nyc": "^15.1.0",
    "prettier": "^2.8.8",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1"
  }
}
