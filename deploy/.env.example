# Copy to deploy/.env on the VPS (chmod 600). Fill from Railway Variables.

SWITCH_NODE_ENV=production
DAYFI_NODE_ENV=production
DAYFI_PORT=3000

# Railway Postgres — use PUBLIC URL (Connect → Public Network), NOT *.railway.internal
# Internal hostnames only work inside Railway; VPS needs *.railway.app + often ?sslmode=require
# DAYFI_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway?sslmode=require
DAYFI_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway

DAYFI_JWT_SECRET=
# Access token lifetime (e.g. 30d, 7d, 24h). Default when unset: 30 days.
DAYFI_JWT_TIME_TO_LIVE=30d
DAYFI_SALT_ROUND=12
WALLET_ENCRYPTION_KEY=

# Public API base (no trailing slash) — used for Smile callback if DAYFI_SMILE_CALLBACK_URL unset.
DAYFI_APP_URL=https://api.dayfi.co

DAYFI_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
DAYFI_FLUTTERWAVE_SECRET_KEY=FLWSECK-...
DAYFI_FLUTTERWAVE_ENCRYPTION_KEY=
DAYFI_FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# Flat transfer fee for bank / P2P / YC wallet sends (USD) — returned as `fees` on wallet-transactions
DAYFI_TRANSFER_FEE_USD=0.05

DAYFI_YELLOWCARD_API_KEY=
DAYFI_YELLOWCARD_API_SECRET=
DAYFI_YELLOWCARD_BASE_URL=https://api.yellowcard.io

DAYFI_SMILE_CALLBACK_URL=https://api.dayfi.co/api/v1/kyc/smile/webhook

# Stellar mainnet — copy MASTER_* from a MAINNET-funded dayfi.wallet master wallet
# (see scripts/sync-stellar-env-from-wallet.sh). Testnet keys will NOT work on mainnet.
STELLAR_NETWORK=mainnet
STELLAR_HORIZON_URL=https://horizon.stellar.org
MASTER_WALLET_PUBLIC_KEY=
# Prefer encrypted secret (same format as dayfi.wallet)
MASTER_ENCRYPTED_SECRET_KEY=
# Decrypts MASTER_ENCRYPTED_SECRET_KEY; use dayfi.wallet WALLET_ENCRYPTION_KEY if keys differ
MASTER_WALLET_ENCRYPTION_KEY=
# Plain secret fallback (dev only)
# MASTER_WALLET_SECRET_KEY=
# XLM sent to each user's Stellar deposit address (max 1; trustlines sponsored separately)
STELLAR_FUNDING_AMOUNT_XLM=1
# dayfi.wallet alias (optional)
# FUNDING_AMOUNT=1
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_EURC_ISSUER=GDHU6WRG4IEQXM5NZ4BMPKOXHW76MZM4Y2IEMFDVXBSDP6SJY4ITNPP2

# DayX v2 voice assistant
# GROQ powers the chat brain; YarnGPT powers Nigerian TTS. Both keys stay server-side.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
YARNGPT_API_KEY=sk_live_...
YARNGPT_DEFAULT_VOICE=Idera

# Optional: protect GET /api/v1/health/egress-ip
# DAYFI_OPS_TOKEN=openssl-rand-hex-32

# Dayfi Back Office — bootstrap operator (created only when infra_operators is empty)
# DAYFI_OPERATOR_EMAIL=ops@dayfi.co
# DAYFI_OPERATOR_PASSWORD=
# Opt-in local password reset on next ensureBootstrapOperator call:
# DAYFI_OPERATOR_SYNC_PASSWORD=true
