# Copy to .env and replace placeholders.

# Production: set SWITCH_NODE_ENV=production so src/config/env loads prod.ts.
# PaaS often injects PORT and DATABASE_URL; the app maps those when DAYFI_* is unset.
# SWITCH_NODE_ENV=production
# DAYFI_NODE_ENV=production

DAYFI_NODE_ENV=development

# HTTP port (must match Flutter dev baseUrl, e.g. http://127.0.0.1:3000/api/v1)
DAYFI_PORT=3000

# Postgres URL: username is the DB role (e.g. postgres), never the literal word USER.
# Port 5433 = this repo’s Docker Compose (avoids clashing with another Postgres on 5432).
DAYFI_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/dayfi

DAYFI_JWT_SECRET=your-super-secret-jwt-key-here
DAYFI_JWT_TIME_TO_LIVE=24h
DAYFI_SALT_ROUND=12

# Outbound email — Resend (HTTPS, recommended on Railway). When DAYFI_RESEND_API_KEY is set, SMTP is not used.
# Create an API key at https://resend.com/api-keys — verify your domain in Resend, then set FROM to that domain.
# DAYFI_RESEND_API_KEY=re_xxxxxxxx
# DAYFI_RESEND_FROM=Dayfi <noreply@yourdomain.com>
# Dev-only (sends to your own verified inbox): defaults to Dayfi <onboarding@resend.dev> if FROM is unset.

# Outbound email — SMTP fallback (Nodemailer). Used only when DAYFI_RESEND_API_KEY is unset. On cloud, prefer 587 + STARTTLS.
# Zoho EU: DAYFI_SMTP_HOST=smtp.zoho.eu DAYFI_SMTP_PORT=587 DAYFI_SMTP_SECURE=false
DAYFI_SMTP_HOST=smtp.zoho.eu
DAYFI_SMTP_PORT=587
DAYFI_SMTP_SECURE=false
DAYFI_SMTP_USER=no-reply@dayfi.co
DAYFI_SMTP_PASS=your-smtp-password-or-app-password
# Optional override of From header (defaults to "Dayfi" <no-reply@dayfi.co> if unset).
# DAYFI_SMTP_FROM="Dayfi" <no-reply@dayfi.co>

# Sign in with Apple: comma-separated iOS bundle IDs (aud claim). Defaults include com.dayfi.* flavors.
# DAYFI_APPLE_CLIENT_IDS=com.dayfi.pilot,com.dayfi.prod

DAYFI_PAYSTACK_URL=https://api.paystack.co
DAYFI_PAYSTACK_SECRET_KEY=your-paystack-secret-key
DAYFI_PAYSTACK_PUBLIC_KEY=your-paystack-public-key

DAYFI_MONO_SECRET_KEY=your-mono-secret-key
DAYFI_MONO_PUBLIC_KEY=your-mono-public-key

DAYFI_FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
DAYFI_FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
DAYFI_FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=test-auth-token
TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000

DAYFI_YELLOWCARD_API_KEY=your-yellowcard-api-key
DAYFI_YELLOWCARD_API_SECRET=your-yellowcard-api-secret
DAYFI_YELLOWCARD_BASE_URL=https://api.yellowcard.io

DAYFI_SMILE_PARTNER_ID=your-smile-partner-id
DAYFI_SMILE_API_KEY=your-smile-api-key
DAYFI_SMILE_BASE_URL=https://api.smileidentity.com
DAYFI_SMILE_CALLBACK_URL=https://your-domain.com/smile-callback

# Optional feature flag (production defaults false when unset).
# DAYFI_STABLECOIN_TOPUP_ENABLED=true
